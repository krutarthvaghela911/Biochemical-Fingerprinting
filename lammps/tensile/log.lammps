  special bond factors coul:  0        1        1       
     2 = max # of 1-2 neighbors
     6 = max # of special neighbors
  special bonds CPU = 0.000 seconds

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001

# ─── Stress ──────────────────────────────────────────────────────────────────
compute         myStress all stress/atom NULL
compute         myPress all reduce sum c_myStress[1] c_myStress[2] c_myStress[3]

variable        Lx0 equal $(lx)
variable        Lx0 equal 20
variable        V0  equal $(vol)
variable        V0  equal 8000
variable        lambda equal lx/v_Lx0
variable        sigmaxx equal -c_myPress[1]/v_V0

thermo          2000
thermo_style    custom step v_lambda v_sigmaxx temp

fix             out all print 200 "${lambda} ${sigmaxx}"                 file /home/krutarth0911/biomechanical-fingerprinting/lammps/tensile/stress_stretch.txt                 screen no title "lambda sigmaxx"

# ─── Low temperature + fast deformation ──────────────────────────────────────
fix             1 all nvt temp 0.1 0.1 0.5
fix             2 all deform 1 x erate 1e-3 units box remap x

run             300000
