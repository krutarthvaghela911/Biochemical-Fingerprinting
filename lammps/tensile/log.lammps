neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.001

compute         myStress all stress/atom NULL
compute         myPress all reduce sum c_myStress[1] c_myStress[2] c_myStress[3]

variable        Lx0 equal $(lx)
variable        Lx0 equal 15
variable        V0  equal $(vol)
variable        V0  equal 3375
variable        lambda equal lx/v_Lx0
variable        sigmaxx equal -c_myPress[1]/v_V0

thermo          2000
thermo_style    custom step v_lambda v_sigmaxx temp

fix             out all print 100 "${lambda} ${sigmaxx}"                 file /home/krutarth0911/biomechanical-fingerprinting/lammps/tensile/stress_stretch.txt                 screen no title "lambda sigmaxx"

fix             1 all nvt temp 0.05 0.05 0.5
fix             2 all deform 1 x erate 1e-3 units box remap x

run             300000
